<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phone and Call log are only used for caller announcement, and only requested when it is
         turned on. Contacts is used by announcement (names) and by Favorites.
         The app has no internet access, so numbers and names never leave the phone. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Favorites: star and unstar contacts. Asked for only when Favorites or Contacts is opened. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Call straight from the app instead of opening the phone app first. Asked for on the first
         call; without it, Call opens the phone app with the number filled in. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Phone app (only once you make this the default phone app):
         show the call notification, open the call screen over the lock screen,
         and turn the screen off against your ear during a call. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibrate for an incoming call while the ringtone takes turns with the caller announcement
         (Android's own ringtone and vibration are silenced then). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Calling needs a phone line, but declaring it optional keeps the app installable on
         devices without one (they simply can't place calls). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Lets the app find the phone's text-to-speech voice (required since Android 11). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dialer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Dial this number" from other apps and tel: links. Android requires these
                 before it lets the app become the default phone app. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The incoming-call and in-call screen. Its own task, so it can come and go
             without disturbing the rest of the app. -->
        <activity
            android:name=".incall.InCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.secnewt.dialer.incall"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Android hands calls to this service once the app is the default phone app. -->
        <service
            android:name=".incall.DialerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Answer, Decline and Hang up from the notification; not reachable by other apps. -->
        <receiver
            android:name=".incall.CallActionReceiver"
            android:exported="false" />

        <!-- Lets the app hold the "Caller ID & spam app" role and see calls before they ring. -->
        <service
            android:name=".screening.SpamScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Hears when the phone starts ringing, so the caller can be announced. -->
        <receiver
            android:name=".announce.IncomingCallReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
